# Local metadata index. Relative paths are resolved from the process working directory.
COPILOT_METADATA_DB=data/metadata.sqlite3

# Directory containing manifest.json and catalog.json.
COPILOT_ARTIFACT_DIR=demo/jaffle_shop/target
COPILOT_DBT_PROJECT_DIR=demo/jaffle_shop
COPILOT_METRICFLOW_EXECUTABLE=.venv/bin/mf

# Allow only confirmed, server-compiled metric queries against the included read-only DuckDB demo.
COPILOT_METRIC_EXECUTION_ENABLED=true

# Ingest the configured artifacts during API startup.
COPILOT_AUTO_INGEST=true

# Streamlit-to-FastAPI URL.
COPILOT_API_URL=http://localhost:8000

# Optional. Local startup parses this project's .env without executing it.
# Without a key, deterministic features remain available and chat is disabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
